# Copy to frontend/.env only if you need to override the dev proxy.
# Left unset, the app calls /api on its own origin and Vite proxies it to
# http://127.0.0.1:8000 (see vite.config.js).
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Dashboard poll interval in milliseconds (§26: 3-5s reads as real-time).
VITE_POLL_INTERVAL_MS=4000
