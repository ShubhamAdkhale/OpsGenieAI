# Copy to backend/.env and adjust if needed. .env is gitignored.

# SQLite file lives at the repo root by default. Swap for a Postgres URL to
# move to a real server later — SQLAlchemy makes this a one-line change.
DATABASE_URL=sqlite:///./opsgenie.db

# Comma-separated list of allowed browser origins. Vite dev server default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Live physics simulation -------------------------------------------------
# The causal core: every operational value (cargo temperature, excursion
# minutes, shelf life, route delay, machine wear, inventory) is integrated
# forward by this loop and then re-derived by the risk engine. Setting it false
# freezes the world at its seeded state — it does not make the numbers wrong,
# it just stops them moving.
PHYSICS_ENABLED=true

# Wall-clock seconds between ticks.
PHYSICS_TICK_SECONDS=3

# Simulated minutes advanced per tick. Together with the line above this sets
# the demo's pace: 6 minutes per 3 seconds means one real minute of watching is
# two simulated hours of transit, so a refrigeration fault becomes visible
# while someone is still talking about it. Raise for a faster demo.
SIM_MINUTES_PER_TICK=6

# Integration step used while a triggered scenario settles. Coarser than the
# live tick purely for speed; the cargo box has a ~3.3 hour thermal time
# constant, so a 15-minute Euler step tracks it closely.
SETTLE_STEP_MINUTES=15

# --- Demo lifecycle ----------------------------------------------------------
# Nothing in the world ever finishes, so an unattended board decays. These bound
# it into an episode: pause while nobody polls, reset for a visitor returning
# after a long absence, restart an unattended episode after EPISODE_SIM_HOURS
# (never within ACTION_GRACE_MINUTES of a button press).
AUTO_RESET_ENABLED=true
IDLE_PAUSE_SECONDS=90
IDLE_RESET_MINUTES=20
EPISODE_SIM_HOURS=24
ACTION_GRACE_MINUTES=5

# --- Weather (Open-Meteo) ----------------------------------------------------
# The only genuinely live input in this build. Keyless public API, one batched
# request for every lane waypoint. If it is unreachable the app falls back to a
# deterministic simulated diurnal curve and LABELS it as simulated — it never
# presents a fallback reading as live. Set false to force the offline path.
WEATHER_ENABLED=true
WEATHER_TIMEOUT_SECONDS=4
WEATHER_REFRESH_SECONDS=600

# --- Spoilage probability source ---------------------------------------------
# false (default) = calibrated logistic curve on the Melt Index (transparent).
# true            = route through the trained GradientBoostingClassifier.
USE_ML_SPOILAGE=false
